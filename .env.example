NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kouci
# EMAIL_VERIFIER_API_URL=https://provider.example/v1/verify

# Generate development secrets with npm run license:keys (.env.license is loaded automatically).
# In production inject these into the process environment or a secret manager.
# LICENSE_CODE_HASH_SECRET=base64-encoded-32-random-bytes
# LICENSE_SIGNING_PRIVATE_KEY=base64-encoded-PKCS8-DER-Ed25519-private-key

# Optional: enables authenticated HTTP activation resets for the back office.
# Use a random token of at least 32 characters, kept out of the mobile app.
# LICENSE_ADMIN_TOKEN=

# Production TLS terminates at a reverse proxy. Trust only its real addresses/CIDRs.
# Set X-Forwarded-Proto: https at that proxy and block direct public access to the API.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
