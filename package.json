{
  "name": "kouci-api",
  "version": "1.0.0",
  "private": true,
  "description": "Core backend platform for Kouci, powering synchronization, telemetry, analytics, and data services for water polo teams and clubs.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
